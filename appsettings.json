{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:{PORT}"
      }
    }
  },
  "Jwt": {
    "Key": "${Jwt__Key}"
  },
  "ConnectionStrings": {
    "SchoolDB": "${ConnectionStrings__SchoolDB}"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
